ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
# EXAMPLE_API_KEY=your-key-here
# OpenTelemetry traces and log lines (ADR-0002). docker-compose points the backend at the local
# grafana/otel-lgtm (Tempo and Loki); for a local venv use http://localhost:4318,
# for Grafana Cloud its OTLP endpoint plus OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instance:token>.
# Nothing is exported while the endpoint is empty.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=app-backend
# Langfuse AI call tracing (ADR-0002); AI calls aren't traced while a key is empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
