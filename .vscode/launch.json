{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Docker: Attach to FastAPI",
      "type": "debugpy",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}/src/backend",
          "remoteRoot": "/app"
        }
      ],
      "justMyCode": false
    },
    {
      "name": "FastAPI: Hot Reload",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/src/backend/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src/backend"
      },
      "cwd": "${workspaceFolder}/src/backend",
      "console": "integratedTerminal"
    }
  ]
}
